# --- Secrets ---
.env
*.env
.env.*
!.env.example   # allow a template without secrets

# --- Jekyll build output ---
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# --- Ruby / Bundler ---
.bundle/
vendor/bundle/

# --- Python virtual envs ---
.venv/
venv/
ENV/

# --- VS Code settings ---
.vscode/*
!.vscode/settings.json  # allow project-specific settings if needed

# --- macOS system files ---
.DS_Store
WARP.md

# --- Python cache ---
__pycache__/
*.py[cod]

# --- NZ P-wave moveout generated artifacts ---
projects/nz-p-wave-moveout/*.png
projects/nz-p-wave-moveout/*.npz
projects/nz-p-wave-moveout/remote-kernel/
